{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: our commands (engine intents/snapshot, settings and onboarding, read-only browse and Home, Navidrome playlist edits, preferences (the accent), the browsed source, saved mixes and the mix editor's searches, the window's real full-screen state) and listening to the engine's events; of the window APIs only entering and leaving full screen (Now Playing). Nothing else (no emit, menu, tray, path or webview APIs; dragging is in macos.json). tests/acl.rs checks the exact core: set.",
  "windows": ["main"],
  "permissions": [
    "allow-intent",
    "allow-snapshot",
    "allow-settings-get",
    "allow-settings-test-server",
    "allow-settings-save-server",
    "allow-settings-disconnect",
    "allow-settings-pick-folder",
    "allow-settings-set-music-dir",
    "allow-settings-set-options",
    "allow-onboarding-finish",
    "allow-local-artists",
    "allow-local-albums",
    "allow-local-artist",
    "allow-local-album",
    "allow-local-genres",
    "allow-local-genre",
    "allow-local-folder",
    "allow-local-playlists",
    "allow-local-playlist",
    "allow-local-search",
    "allow-local-lyrics-search",
    "allow-navidrome-artists",
    "allow-navidrome-artist",
    "allow-navidrome-artist-tracks",
    "allow-navidrome-album",
    "allow-navidrome-albums",
    "allow-navidrome-genres",
    "allow-navidrome-genre-albums",
    "allow-navidrome-genre-random-songs",
    "allow-navidrome-playlists",
    "allow-navidrome-playlist",
    "allow-navidrome-random-songs",
    "allow-navidrome-search",
    "allow-navidrome-lyrics-search",
    "allow-playlist-create",
    "allow-playlist-save-queue",
    "allow-playlist-add",
    "allow-playlist-rename",
    "allow-playlist-delete",
    "allow-playlist-remove",
    "allow-playlist-reorder",
    "allow-prefs-get",
    "allow-prefs-set-accent",
    "allow-ui-source-get",
    "allow-ui-source-set",
    "allow-home-history",
    "allow-home-daily-picks",
    "allow-now-playing-lyrics",
    "allow-lyrics-index-status",
    "allow-lyrics-index-rebuild",
    "allow-lyrics-index-set-enabled",
    "allow-list-mixes",
    "allow-add-mix",
    "allow-update-mix",
    "allow-add-to-mix",
    "allow-delete-mix",
    "allow-mix-search-genres",
    "allow-mix-search-artists",
    "allow-mix-search-albums",
    "allow-window-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
