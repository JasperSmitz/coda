{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: our commands (engine intents/snapshot, settings and onboarding, read-only browse) and listening to the engine's events. Nothing else (no emit, menu, tray, path, window or webview APIs).",
  "windows": ["main"],
  "permissions": [
    "allow-intent",
    "allow-snapshot",
    "allow-settings-get",
    "allow-settings-test-server",
    "allow-settings-save-server",
    "allow-settings-disconnect",
    "allow-settings-pick-folder",
    "allow-settings-set-music-dir",
    "allow-settings-set-options",
    "allow-onboarding-finish",
    "allow-local-artists",
    "allow-local-albums",
    "allow-local-artist",
    "allow-local-album",
    "allow-local-folder",
    "allow-local-playlists",
    "allow-local-playlist",
    "allow-local-search",
    "allow-navidrome-artists",
    "allow-navidrome-artist",
    "allow-navidrome-artist-tracks",
    "allow-navidrome-album",
    "allow-navidrome-albums",
    "allow-navidrome-playlists",
    "allow-navidrome-playlist",
    "allow-navidrome-random-songs",
    "allow-navidrome-search",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
